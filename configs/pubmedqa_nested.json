{
  "target": "pubmedqa",
  "data": {
    "total_n": 500,
    "test_n": 50,
    "train_sample_size": 25,
    "split": "train"
  },
  "optimizer": {
    "max_steps": 30,
    "n_samples": 30,
    "model": "together_ai/moonshotai/Kimi-K2.5",
    "max_llm_calls": 150,
    "max_evals": 20,
    "max_no_improve_steps": 8
  },
  "spawn": {
    "l2": {
      "max_steps": 10,
      "n_samples": 1,
      "max_llm_calls": 80,
      "max_evals": 10,
      "max_no_improve_steps": 5
    },
    "mini_l1": {
      "max_steps": 30,
      "n_samples": 30,
      "max_llm_calls": 150,
      "max_evals": 20,
      "max_no_improve_steps": 8
    }
  },
  "nesting": {
    "max_depth": 2,
    "max_spawn_calls": 1
  },
  "output": "results_pubmedqa_nested.json"
}
